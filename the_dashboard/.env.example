# Dashboard host port exposed by Nginx.
DASHBOARD_HTTP_PORT=8080

# Dashboard config mounted into both Nginx and Gateway. Copy dashboard/config.js
# to dashboard/config.local.js and select that ignored path for local values.
DASHBOARD_CONFIG_PATH=./dashboard/config.js

# Gateway upstream timeout for dependency calls, in milliseconds.
GATEWAY_UPSTREAM_TIMEOUT_MS=5000

# Home Assistant base URL reachable from the Gateway container.
HOME_ASSISTANT_BASE_URL=http://host.docker.internal:8123

# Home Assistant long-lived access token. Keep the real value local and uncommitted.
HOME_ASSISTANT_TOKEN=

# Todo server base URL.
TODO_API_BASE_URL=http://host.docker.internal:5000

# Status probe timeout, target count, concurrency, and allowed host patterns.
STATUS_PROBE_TIMEOUT_MS=5000
STATUS_PROBE_MAX_TARGETS=100
STATUS_PROBE_CONCURRENCY=10
STATUS_PROBE_ALLOWED_HOSTS=localhost

# Default ping target used by Gateway network diagnostics when no target is requested.
NETSTATS_PING_TARGET=8.8.8.8

# Internal read-only Docker API proxy used for container health counts.
SYSTEM_HEALTH_CONTAINER_API_URL=http://docker_socket_proxy:2375
